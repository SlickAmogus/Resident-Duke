// SPDX-License-Identifier: GPL-3.0-only
// Resident Duke: Jill Valentine and the RE1 PC gameplay slice inside Duke Nukem 3D's E1L1.
// Gameplay logic is ported from Resident Doom's ZScript, which adapts the
// RE1 PC decomp (https://github.com/ecruells/resident-evil-pc-decomp).
// Source addresses in comments refer to that decomp. Load order matters:
// CON states must be defined before they are called.

include GAME.CON

include gen/data.con      // generated: tile numbers, table arrays, map constants
include scripts/defs.con      // constants and state variables
include gen/tables.con    // generated: re_load_tables
include scripts/util.con      // tables, text, items, sounds, UI drawing primitives
include scripts/world.con     // world freeze, cameras, Duke HUD suppression
include scripts/jill.con      // animation banks and the visible Jill model
include scripts/inventory.con // carried items, item box transfers, herbs
include scripts/messages.con  // original STR message streams and prompts
include scripts/viewer.con    // item model viewer and pickups
include scripts/status.con    // status screen and item box state machines
include scripts/save.con      // typewriter saves
include scripts/death.con     // death sequence and title screen
include scripts/casing.con    // spent casing effect
include scripts/control.con   // tank movement, gun behaviours, interaction
include scripts/actors.con    // pickups, glints, stations
include scripts/overlay.con   // native 320x240 RE UI rendering
include scripts/events.con    // engine event wiring
